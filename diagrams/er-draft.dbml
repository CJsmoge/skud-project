Table Employee {
  id int [pk, increment]
  full_name varchar(100) [not null]
  department varchar(100) [not null]
  position varchar(100) [not null]
  phone varchar(20)
  email varchar(255)
  created_at timestamp [not null]
}

Table Card {
  id int [pk, increment]
  employee_id int [ref: > Employee.id]
  number varchar(20) [unique]
  status varchar(20)
  issued_at timestamp
  blocked_at timestamp
}

Table Zone {
  id int [pk, increment]
  name varchar(100) [not null]
  description text
  level_id int [not null, ref: > AccessLevel.id]
}

Table AccessLevel {
  id int [pk, increment]
  name varchar(50) [not null]
  description text
}

Table Request {
  id int [pk, increment]
  employee_id int [not null, ref: > Employee.id]
  card_id int [not null, ref: > Card.id]
  zone_id int [not null, ref: > Zone.id]
  controller_id int [not null, ref: > Controller.id]
  event_time timestamp [not null]
  direction varchar(10) [not null]
}

Table Controller {
  id int [pk, increment]
  zone_id int [not null, ref: > Zone.id]
  name varchar(100) [not null]
  location varchar(255)
  is_active boolean [not null]
}

Table StatusHistory {
  id int [pk, increment]
  card_id int [not null, ref: > Card.id]
  old_status varchar(20) [not null]
  new_status varchar(20) [not null]
  changed_at timestamp [not null]
}